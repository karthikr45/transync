{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "purpose",
    "changePolicy",
    "screenRules",
    "designTokens",
    "components",
    "nativeOwners",
    "customWidgetRoles",
    "legacyRoleExceptions",
    "packageApprovals"
  ],
  "properties": {
    "version": { "const": 1 },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "status", "useFor", "accessibility"],
        "properties": { "status": { "enum": ["approved", "legacy-reference"] } }
      }
    },
    "nativeOwners": { "type": "object", "additionalProperties": { "type": ["string", "null"] } },
    "customWidgetRoles": { "type": "array", "items": { "type": "string" } },
    "legacyRoleExceptions": {
      "type": "array",
      "items": { "type": "object", "required": ["path", "roles", "reason", "maxOccurrences"] }
    },
    "packageApprovals": {
      "type": "object",
      "additionalProperties": { "type": "object", "required": ["kind", "owner", "reason"] }
    }
  }
}
