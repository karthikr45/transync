# Backend base URL. The client calls this URL directly, so it must be
# prefixed with NEXT_PUBLIC_ to be available in the browser bundle.
# (Plain API_BASE_URL is honoured as a fallback for older .env files.)
NEXT_PUBLIC_API_BASE_URL=https://d0b4-183-82-114-188.ngrok-free.app

# Optional: a public build/release identifier.
# NEXT_PUBLIC_RELEASE_ID=

# Optional: forward CSP violation reports to an external collector.
# CSP_REPORT_FORWARD_URL=
