# Backend base URL (server-only). NEXT_PUBLIC_API_BASE_URL is supported as
# a fallback for backwards compatibility, but new deployments should use
# API_BASE_URL so the URL never ends up in the client bundle.
API_BASE_URL=https://d0b4-183-82-114-188.ngrok-free.app

# Optional: a public ID used by build pipelines / logging.
# NEXT_PUBLIC_RELEASE_ID=

# Optional: error reporting. When set, instrumentation.ts and
# lib/observability.ts forward events to Sentry (after uncommenting the
# wiring in those files and installing @sentry/nextjs).
# SENTRY_DSN=

# Optional: forward CSP violation reports to an external collector
# (Sentry / report-uri.com / etc.).
# CSP_REPORT_FORWARD_URL=
